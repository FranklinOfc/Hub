--AutoStamina
function AutoStamina()
    task.spawn(function()
        while _G.AutoStamina do
            for _ = 1, 5 do
                ReplicatedStorage.AddStaminaEvent:FireServer()
                ReplicatedStorage.AddStaminaEvent:FireServer()
                ReplicatedStorage.AddStaminaEvent:FireServer()
            end
            task.wait()
        
        end
    end)
SCRIPT
end
