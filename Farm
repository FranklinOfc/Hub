-- Load Orion Library
local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/hakaiofc/Base/main/HUBORION'))()

local ReplicatedStorage = game:GetService("ReplicatedStorage")

_G.AutoStamina = false

-- Função de AutoStamina
function AutoStamina()
    task.spawn(function()
        while _G.AutoStamina do
            for _ = 1, 1 do
                ReplicatedStorage.AddStaminaEvent:FireServer()
            end
            task.wait()
        end
    end)
end

-- Criando Interface
local Window = OrionLib:MakeWindow({
    Name = "FarmeExclusive",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "OrionTest",
    IntroEnabled = false
})

local HubExclusivoTab = Window:MakeTab({
    Name = "Menu 1",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

HubExclusivoTab:AddSection({ Name = "Auto-Farm" })

HubExclusivoTab:AddToggle({
    Name = "AutoStamina",
    Default = false,
    Callback = function(Value)
        _G.AutoStamina = Value
        if Value then AutoStamina() end
    end
})

local AdicionaisTab = Window:MakeTab({
    Name = "FUNÇÕES A+",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

AdicionaisTab:AddSection({ Name = "FUNÇÕES ADICIONAIS" })

AdicionaisTab:AddButton({
    Name = "InfiniteYield",
    Callback = function()
        loadstring(game:HttpGet('https://raw.githubusercontent.com/hakaiofc/EdgeIYinfiniteyield/main/mastersource'))()
    end
})
